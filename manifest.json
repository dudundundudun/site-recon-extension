{
  "manifest_version": 3,
  "name": "One-Button Site Recon for AI",
  "version": "1.0.0",
  "description": "Полная разведка сайта в один клик: DOM, сеть (Fetch/XHR), медиа, глобальные переменные и хранилища — готовый JSON/MD отчет для ИИ.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "cookies"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Запустить разведку сайта"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["interceptor.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    }
  ]
}
